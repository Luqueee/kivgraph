diff --git a/BUILD.bazel b/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/BUILD.bazel
@@ -0,0 +1,52 @@
+load("@rules_cc//cc:defs.bzl", "cc_library")
+load("@io_bazel_rules_go//go:def.bzl", "go_library")
+
+cc_library(
+    name = "tree_sitter_core",
+    srcs = ["src/lib.c"],
+    hdrs = glob([
+        "src/*.c",
+        "include/**/*.h",
+        "src/**/*.h",
+    ]),
+    includes = [
+        "include",
+        "src",
+    ],
+    visibility = ["//visibility:public"],
+)
+
+go_library(
+    name = "go-tree-sitter",
+    srcs = [
+        "allocator.c",
+        "allocator.go",
+        "allocator.h",
+        "dup_unix.go",
+        "dup_windows.go",
+        "edit.go",
+        "language.go",
+        "logger.go",
+        "lookahead_iterator.go",
+        "node.go",
+        "parser.go",
+        "point.go",
+        "query.go",
+        "ranges.go",
+        "tree.go",
+        "tree_cursor.go",
+        "tree_sitter.go",
+    ],
+    cgo = True,
+    cdeps = [":tree_sitter_core"],
+    copts = ["-Iinclude", "-Isrc", "-std=c11", "-D_POSIX_C_SOURCE=200112L", "-D_DEFAULT_SOURCE"],
+    deps = ["@com_github_mattn_go_pointer//:go_default_library"],
+    importpath = "github.com/tree-sitter/go-tree-sitter",
+    visibility = ["//visibility:public"],
+)
+
+alias(
+    name = "go_default_library",
+    actual = ":go-tree-sitter",
+    visibility = ["//visibility:public"],
+)
diff --git a/tree_sitter.go b/tree_sitter.go
--- a/tree_sitter.go
+++ b/tree_sitter.go
@@ -6,1 +6,0 @@
-#include "lib.c" // <- This is needed to build the C library from the C source code, but cannot be included in files that have other declarations.

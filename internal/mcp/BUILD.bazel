load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mcp",
    srcs = [
        "instructions.go",
        "server.go",
        "transport.go",
    ],
    importpath = "github.com/Luqueee/kivgraph/internal/mcp",
    visibility = ["//:__subpackages__"],

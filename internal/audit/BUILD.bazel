load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "audit",
    srcs = [
        "audit.go",
        "buildtags.go",
        "golang.go",
        "rust.go",
        "typescript.go",
    ],
    importpath = "github.com/Luqueee/kivgraph/internal/audit",

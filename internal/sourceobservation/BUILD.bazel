load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sourceobservation",
    srcs = [
        "invalidation.go",
        "observation.go",
    ],
    importpath = "github.com/Luqueee/kivgraph/internal/sourceobservation",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/topology",
        "//internal/workspace",
    ],
)

go_test(
    name = "sourceobservation_test",
    srcs = [
        "invalidation_test.go",
        "observation_nonregular_test.go",
        "observation_test.go",
    ],
    data = ["//:testdata"],
    embed = [":sourceobservation"],
    env_inherit = ["PATH"],
    deps = [
        "//internal/config",
        "//internal/testsupport",
        "//internal/topology",
        "//internal/workspace",
    ],
)

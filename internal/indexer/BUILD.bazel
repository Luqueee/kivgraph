load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "indexer",
    srcs = [
        "factcache.go",
        "full.go",
        "rust_unit.go",
        "semantic.go",
    ],
    importpath = "github.com/Luqueee/kivgraph/internal/indexer",

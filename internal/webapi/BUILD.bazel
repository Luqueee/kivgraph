    srcs = [
        "binary_test.go",
        "handler_test.go",
        "server_test.go",
    ],
    embed = [":webapi"],
    deps = [
        "//internal/config",
        "//internal/facts",
        "//internal/hotsnapshot",
        "//internal/invalidation",
        "//internal/sourceobservation",
        "//internal/storage/generation",
        "//internal/testsupport",
        "//internal/topology",
    ],

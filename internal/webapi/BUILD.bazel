load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "webapi",
    srcs = [
        "binary.go",
        "handler.go",
        "server.go",
        "topology.go",
        "topology_types.go",
    ],
    importpath = "github.com/Luqueee/kivgraph/internal/webapi",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/facts",

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "freshness",
    srcs = [
        "cache.go",
        "freshness.go",
        "monitor.go",
    ],
    importpath = "github.com/Luqueee/kivgraph/internal/freshness",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/watcher",
        "//internal/workspace",
        "@com_github_fsnotify_fsnotify//:fsnotify",
    ],
)

go_test(
    name = "freshness_test",
    srcs = ["freshness_test.go"],
    embed = [":freshness"],
    deps = [
        "//internal/config",
        "//internal/workspace",
    ],
)

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "rustloader",
    srcs = [
        "analyze.go",
        "analyze_references.go",
        "crossrepo.go",
        "kinds.go",
        "metadata.go",
        "relations.go",
        "scip_run.go",
        "source.go",
        "symbol.go",
        "sysroot.go",
    ],
    importpath = "github.com/Luqueee/kivgraph/internal/rustloader",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/executable",
        "//internal/hotsnapshot",
        "//internal/scip/scipwire",
        "//internal/syntax",
        "//internal/workspace",
        "@com_github_tree_sitter_go_tree_sitter//:go-tree-sitter",
    ],
)

go_test(
    name = "rustloader_test",
    srcs = [
        "analyze_test.go",
        "collision_test.go",
        "crossrepo_test.go",
        "scip_run_test.go",
        "source_test.go",
        "symbol_test.go",
        "sysroot_test.go",
    ],
    data = ["//:testdata"],
    embed = [":rustloader"],
    deps = [
        "//internal/executable",
        "//internal/scip/scipwire",
        "//internal/syntax",
        "//internal/testsupport",
        "//internal/workspace",
    ],
)

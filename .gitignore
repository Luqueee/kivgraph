# Local tooling
.DS_Store
.env
.env.*
# ...except the template, which carries no value and is the only record of
# which variables a deployment has to set. `.env.*` would swallow it.
!.env.example

# Downloaded toolchain artifacts
.tooling/
/dist/

# graphify writes its graph beside the code it reads; ours is never an input.
/graphify-out/

# `kivgraph index` keeps project-local configuration and graph state here.
.kivgraph/

# stray binary from `go build ./benchmarks/...`: the harness is run with `go run`
/graph-tools-comparison

# Compiled benchmark harnesses. They were committed once, and they embed the
# absolute paths of the machine that built them.
/agent-e2e
/hot-snapshot-footprint
/shared-snapshot

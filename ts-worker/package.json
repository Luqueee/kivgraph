{
  "name": "@kivgraph/ts-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent TypeScript worker for Kivgraph",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "facts": "pnpm build && node dist/facts-cli.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "hello": "pnpm build && node dist/index.js",
    "lint": "biome lint .",
    "precision": "pnpm build && node dist/precision-cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

---
const installCommand =
  "curl -fsSL https://github.com/Luqueee/ladygraph/releases/latest/download/install.sh | bash";
---

<section class="not-content mx-auto w-full max-w-6xl px-6 pt-10 pb-16">
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div>
      <h1 class="text-4xl leading-tight font-semibold sm:text-5xl">
        A canonical code graph for Go, TypeScript and Rust
      </h1>
      <p class="mt-5 max-w-xl text-lg text-(--sl-color-gray-3)">
        Ladygraph indexes repositories locally and serves cross-repository code
        intelligence to any MCP client over stdio. Every exact edge carries the
        evidence that produced it.
      </p>

      <div
        class="mt-7 flex items-stretch gap-2 rounded-lg border border-(--sl-color-gray-5) bg-(--sl-color-black) p-2"
      >
        <code
          id="install-command"
          class="min-w-0 flex-1 overflow-x-auto py-1 font-mono text-xs whitespace-nowrap sm:text-sm"
          >{installCommand}</code
        >
        <button
          id="install-copy"
          type="button"
          data-command={installCommand}
          class="shrink-0 rounded-md border border-(--sl-color-gray-5) px-3 py-1 text-sm hover:bg-(--sl-color-gray-6)"
        >
          Copy
        </button>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/install/"
          class="rounded-md bg-(--sl-color-accent) px-5 py-2 font-medium text-(--sl-color-white) no-underline"
          >Install</a
        >
        <a
          href="https://github.com/Luqueee/ladygraph"
          class="rounded-md border border-(--sl-color-gray-5) px-5 py-2 font-medium no-underline"
          >GitHub</a
        >
      </div>
    </div>

    <div
      class="relative aspect-square w-full overflow-hidden rounded-xl border border-(--sl-color-gray-5) bg-(--sl-color-black)"
    >
      <canvas
        id="hero-graph"
        class="h-full w-full"
        aria-label="A synthetic code graph: repositories holding packages, files and symbols, with cross-repository dependencies between them."
        role="img"></canvas>
    </div>
  </div>

  <ul class="mt-10 flex list-none flex-wrap gap-3 p-0 text-sm">
    {
      ["Local only", "MCP over stdio", "Apache-2.0"].map((chip) => (
        <li class="rounded-full border border-(--sl-color-gray-5) px-3 py-1 text-(--sl-color-gray-2)">
          {chip}
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { startHeroGraph } from "../lib/hero-graph";

  const canvas = document.getElementById("hero-graph");
  if (canvas instanceof HTMLCanvasElement) {
    startHeroGraph(canvas);
  }

  const copy = document.getElementById("install-copy");
  if (copy instanceof HTMLButtonElement) {
    copy.addEventListener("click", async () => {
      const command = copy.dataset.command;
      if (command === undefined) {
        return;
      }
      await navigator.clipboard.writeText(command);
      copy.textContent = "Copied";
      window.setTimeout(() => {
        copy.textContent = "Copy";
      }, 1500);
    });
  }
</script>

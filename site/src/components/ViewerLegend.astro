---
// The eight colours of the viewer legend, declared once in global.css.
const swatches = [
  { label: "Repository", variable: "--color-graph-repository" },
  { label: "Package", variable: "--color-graph-package" },
  { label: "File", variable: "--color-graph-file" },
  { label: "Symbol", variable: "--color-graph-symbol" },
  { label: "Containment", variable: "--color-graph-containment" },
  { label: "Local dependency", variable: "--color-graph-local" },
  { label: "Cross dependency", variable: "--color-graph-cross" },
  { label: "Exact dependency", variable: "--color-graph-exact" },
];
---

<section class="not-content mx-auto w-full max-w-6xl px-6 py-12">
  <h2 class="text-2xl font-semibold">Look at the graph</h2>
  <p class="mt-3 max-w-3xl text-(--sl-color-gray-3)">
    <code>ladygraph ui</code> serves a read-only viewer over the published
    snapshot. It draws repositories, packages, files and symbols with the
    containment that holds them and the dependencies between them, deriving its
    own 3D layout from the structure of each tile. The endpoint carries no
    authentication and binds every interface by default; restrict it
    with <code>--addr</code> or <code>web.address</code>.
  </p>
  <ul class="mt-6 flex list-none flex-wrap gap-x-6 gap-y-3 p-0 text-sm">
    {
      swatches.map((swatch) => (
        <li class="flex items-center gap-2">
          <span
            class="inline-block h-3 w-3 rounded-full"
            style={`background:var(${swatch.variable})`}
          />
          {swatch.label}
        </li>
      ))
    }
  </ul>
  <p class="mt-6 text-sm">
    <a href="/guides/viewer/">Viewer guide</a>
  </p>
</section>

{
  "name": "Kivgraph",
  "short_name": "Kivgraph",
  "description": "A canonical code graph for Go, TypeScript and Rust, served to any MCP client over stdio.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f1117",
  "theme_color": "#0a0b0d",

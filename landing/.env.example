# The deployment declares itself here. `astro.config.mjs` reads this file with
# `process.loadEnvFile()` and so does `server.mjs`; a variable already exported
# wins over the file.
#
# Nothing in here is a secret. `PUBLIC_POSTHOG_KEY` is a capture key and travels
# in the HTML of every page by design; the Umami website ids do too. An
# administrative PostHog key -- personal, project-secret, or the one the MCP
# uses -- must never appear in this file or anywhere the browser can read.

# Development only. The fallback of `site` is the production origin, so a
# deployment leaves this unset.
KIVGRAPH_LANDING_URL=http://localhost:6767

# Umami, main property. Both or neither: with one missing nothing is emitted.
KIVGRAPH_UMAMI_SCRIPT_URL=
KIVGRAPH_UMAMI_WEBSITE_ID=

# Umami, AI crawlers property. Read by `server.mjs` at startup, not at build.
KIVGRAPH_UMAMI_URL=
KIVGRAPH_UMAMI_AI_WEBSITE_ID=
# Set to `off` to stop reporting crawlers without removing the two above.
KIVGRAPH_UMAMI_AI_TRACKING=

# PostHog Cloud EU. `PUBLIC_` because Astro only exposes prefixed variables to
# client code, which is where the capture key has to run.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

---
// Starlight's `<head>` is already right about the things it owns: the title,
// the description, `rel="canonical"`, the favicon, the OpenGraph set and
// `twitter:card`. This override renders it untouched and appends only what it
// does not emit — a preview image, the rest of the Twitter card, the robots
// directives that unlock rich previews, links to this page's markdown source,
// and the JSON-LD that says what the page is.
//
// Nothing here repeats a tag Starlight emits. `twitter:card` in particular is
// already in its defaults, so only the title, description and image are added.
import Default from "@astrojs/starlight/components/Head.astro";
import {
  LICENSE_URL,
  PREVIEW_ALT,
  PROJECT_NAME,
  absoluteUrl,
  docDescription,
  docPathname,
  hasRawMarkdown,
  isNotFoundPage,
  rawPathname,
  umamiTracker,
} from "../../pages/_seo";

const { entry } = Astro.locals.starlightRoute;

// The 404 route is a real page with a title and no address worth indexing. It
// gets the meta robots tag inverted and none of the rest: there is no markdown
// source for it and no article to describe.
const isNotFound = isNotFoundPage(entry.id);

const description = docDescription(entry);
const preview = absoluteUrl(Astro.site, "/og.png");
// What the preview shows is declared once, in `src/site.mjs`, because both
// heads describe the same file.

// The same analytics the landing shell emits: one instance covers both halves
// of the site, so a visitor who walks from the landing into the documentation
// stays one session.
const umami = umamiTracker();

// Derived from the entry, not from `Astro.url`, so it is byte-identical to the
// `rel="canonical"` Starlight writes: `build.format` is `directory`, which
// makes Starlight's canonical formatter append the trailing slash that
// `docPathname` also appends. Two spellings of one URL is two pages.
const canonical = absoluteUrl(Astro.site, docPathname(entry.id));
const markdown = absoluteUrl(Astro.site, rawPathname(entry.id));

// `/releases/` is a `<StarlightPage>`, so Starlight hands this override an
// entry that looks like a collection page and has no markdown source behind it.
// Only pages the collection really holds get the `rel="alternate"` link; the
// index at `/llms.txt` is the same for every page and stays.
const hasMarkdown = !isNotFound && (await hasRawMarkdown(entry.id));

interface ListItem {
  "@type": "ListItem";
  position: number;
  name: string;
  item?: string;
}

// Google lists `item` under the **required** properties of `ListItem`, with one
// exception: the last crumb in the trail, whose URL it takes from the page.
// This file used to emit one crumb per URL segment and leave `item` off the
// intermediate ones, on the grounds that schema.org marks it optional. Both
// halves of that are true and the conclusion was still wrong: `/docs/`,
// `/docs/tools/`, `/guides/` and `/mcp/` are sidebar groups, all four answer
// 404, and a crumb that cannot carry a URL cannot be published at all. Valid
// schema.org, invalid for Google -- the difference between markup that parses
// and a breadcrumb that appears.
// https://developers.google.com/search/docs/appearance/structured-data/breadcrumb
//
// So the trail is the addressable steps, which is also what the guideline asks
// for -- "breadcrumbs that represent a typical user path to a page, instead of
// mirroring the URL structure" -- and it meets the two-item minimum.
const breadcrumb: ListItem[] = [
  {
    "@type": "ListItem",
    position: 1,
    name: PROJECT_NAME,
    item: absoluteUrl(Astro.site, "/"),
  },
  {
    "@type": "ListItem",
    position: 2,
    name: entry.data.title,
    item: canonical,
  },
];

// One graph, joined to the landing page's graph by `@id`. `SoftwareApplication`
// and `WebSite` are declared once, on `/`, and referenced from every page here;
// re-declaring them would describe the same two things twice and invite the two
// descriptions to drift.
//
// `breadcrumb` is a property of `WebPage`, not of `Article`, so the
// `BreadcrumbList` stands as its own node instead of hanging off the article.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${canonical}#article`,
      headline: entry.data.title,
      description,
      url: canonical,
      inLanguage: "en",
      isAccessibleForFree: true,
      license: LICENSE_URL,
      isPartOf: { "@id": absoluteUrl(Astro.site, "/#website") },
      about: { "@id": absoluteUrl(Astro.site, "/#software") },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: breadcrumb,
    },
  ],
};
---

<Default {...Astro.props}><slot /></Default>

<meta property="og:image" content={preview} />
{/* The dimensions and the type let a client reserve the space and pick the
    large-summary layout before it has fetched the file. `og:image` itself is
    above; Starlight emits none of these. */}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={PREVIEW_ALT} />
<meta name="twitter:title" content={entry.data.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={preview} />
<meta name="twitter:image:alt" content={PREVIEW_ALT} />

{/* The rest of the icon set. Starlight emits the 32px one from its `favicon`
    option, so repeating it here would be the duplicate. `theme-color` is the
    page colour as a literal because a `<meta>` cannot read a CSS custom
    property; it is the value `--color-shell` carries in global.css. */}
<link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0a0b0d" />

{/* The directives Google documents for full-length snippets and large preview
    images, which is also what an answer engine reads before quoting a page. */}
<meta
  name="robots"
  content={
    isNotFound
      ? "noindex, follow"
      : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  }
/>

<link rel="license" href={LICENSE_URL} />

{
  !isNotFound && (
    <>
      {/* An agent that landed on the HTML can take the markdown source of this
          page instead, per llmstxt.org, when there is one. The index of every
          page there is, below, exists for all of them. */}
      {hasMarkdown && (
        <link
          rel="alternate"
          type="text/markdown"
          href={markdown}
          title={`${entry.data.title} as markdown`}
        />
      )}
      <link rel="describedby" href={absoluteUrl(Astro.site, "/llms.txt")} />
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    </>
  )
}

{/* The tracker of the self-hosted Umami instance, on every page including the
    404: what an unreachable link is, and where it came from, is the one thing
    that page is worth measuring for. `is:inline` because the file belongs to
    that instance and is not bundled here. */}
{
  umami && (
    <script is:inline defer src={umami.src} data-website-id={umami.websiteId} />
  )
}

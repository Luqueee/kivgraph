---
import SubHead from "./SubHead.astro";

const loses = [
  {
    metric: "0.2x",
    text: "for a name the corpus declares twice. A rare name in one small repository is cheaper with grep.",
  },
  {
    metric: null,
    text: "Indexing a small file costs more than reading it, and one small file is cheaper to read than to outline.",
  },
  {
    metric: null,
    text: "It answers from a published generation. Without one, every query that needs a snapshot fails explicitly rather than answering from nothing.",
  },
];

const wins = [
  {
    metric: "28.3x",
    text: "cheaper than grep for a name the corpus declares 126 times.",
  },
  {
    metric: "2.1x",
    text: "cheaper over a whole session.",
  },
  {
    metric: null,
    text: "Transitive impact: grep does not follow a chain.",
  },
  {
    metric: null,
    text: "Consumers in another repository: a language server stops at its workspace.",
  },
  {
    metric: null,
    text: "Proving an absence: an empty reference list means nobody calls it.",
  },
];
---

<div class="grid grid-cols-1 items-baseline gap-10 md:grid-cols-2">
  <div class="border-l-2 border-graph-symbol pl-5">
    <SubHead title="where it loses" />
    <ul class="mt-5 space-y-3 text-sm text-gray-300">
      {
        loses.map((item) => (
          <li>
            {item.metric !== null && (
              <span class="mr-2 text-graph-symbol tabular-nums">
                {item.metric}
              </span>
            )}
            {item.text}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-l-2 border-graph-exact pl-5">
    <SubHead title="where it wins" />
    <ul class="mt-5 space-y-3 text-sm text-gray-300">
      {
        wins.map((item) => (
          <li>
            {item.metric !== null && (
              <span class="mr-2 text-graph-exact tabular-nums">
                {item.metric}
              </span>
            )}
            {item.text}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<p class="mt-10 max-w-[68ch] border-t border-rule pt-10 text-xs text-gray-400">
  Measured on a private 41-repository monorepo of 100,118 symbols by the <code
    >benchmarks/mcp-token-cost</code
  > harness, which compares against the host's own tool output captured verbatim.
</p>

<p class="mt-5 text-xs">
  <a href="/limits/" class="text-accent-200 underline underline-offset-4"
    >the limits, in full</a
  >
</p>

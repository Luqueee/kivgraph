---
// The standalone shell for the landing page. It imports nothing from
// Starlight: `--sl-color-*` does not exist outside a Starlight page, so the
// page runs on the Tailwind theme in global.css alone. The surfaces it needs
// (shell, panel, raise, rule, rule-strong) are declared there, in `@theme`,
// and shared with the documentation.
import "../../styles/global.css";
import {
  GOOGLE_SITE_VERIFICATION,
  LICENSE_NAME,
  LICENSE_URL,
  PROJECT_NAME,
  PROJECT_TAGLINE,
  REPOSITORY_URL,
  absoluteUrl,
  umamiTracker,
} from "../../pages/_seo";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Absolute and derived from `site`, never a literal: the deployment sets
// KIVGRAPH_LANDING_URL and a hardcoded host would publish the wrong canonical.
const canonical = absoluteUrl(Astro.site, Astro.url.pathname);
const preview = absoluteUrl(Astro.site, "/og.png");

// Self-hosted analytics, or nothing at all when the deployment declares none.
const umami = umamiTracker();

// One graph, not three scripts. `SoftwareApplication` is what an answer engine
// reads to say what Kivgraph is; `WebSite` ties the pages together and carries
// the documentation search action.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": absoluteUrl(Astro.site, "/#software"),
      name: PROJECT_NAME,
      description: PROJECT_TAGLINE,
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: "Static code analysis",
      operatingSystem: "Linux, macOS",
      url: absoluteUrl(Astro.site, "/"),
      codeRepository: REPOSITORY_URL,
      license: LICENSE_URL,
      programmingLanguage: ["Go", "TypeScript", "Rust", "Python", "Dart"],
      isAccessibleForFree: true,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
    {
      "@type": "WebSite",
      "@id": absoluteUrl(Astro.site, "/#website"),
      name: PROJECT_NAME,
      description: PROJECT_TAGLINE,
      url: absoluteUrl(Astro.site, "/"),
      inLanguage: "en",
      license: LICENSE_URL,
      about: { "@id": absoluteUrl(Astro.site, "/#software") },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Search Console verifies an URL-prefix property by fetching its root, so
        the tag lives on this page alone. */}
    <meta
      name="google-site-verification"
      content={GOOGLE_SITE_VERIFICATION}
    />

    {/* The mark is a raster, so there is no vector icon. A stale
        `image/svg+xml` entry would win over these: a browser prefers the
        vector, and it was still the old graph-nodes drawing. */}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0b0d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PROJECT_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={preview} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="license" content={LICENSE_NAME} />

    {/* An agent that lands here can take the whole documentation in one
        fetch instead of crawling thirty pages. */}
    <link
      rel="alternate"
      type="text/plain"
      href={absoluteUrl(Astro.site, "/llms.txt")}
      title="Documentation index for language models"
    />
    <link
      rel="alternate"
      type="text/plain"
      href={absoluteUrl(Astro.site, "/llms-full.txt")}
      title="Full documentation as plain text"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    {/* The tracker of the self-hosted Umami instance, which is why it is
        `is:inline`: the file is served by that instance, not bundled here. */}
    {
      umami && (
        <script
          is:inline
          defer
          src={umami.src}
          data-website-id={umami.websiteId}
        />
      )
    }
  </head>
  <body class="min-h-screen bg-shell font-mono text-gray-100 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-10 focus:border focus:border-rule-strong focus:bg-panel focus:px-3 focus:py-2 focus:text-xs"
      >Skip to content</a
    >
    <slot />
  </body>
</html>

<style>
  /* global.css imports the Tailwind theme and utilities but no preflight, and
     Starlight's reset only runs on Starlight pages. This is the reset for this
     page. It sits in the base layer so every utility still wins over it. */
  @layer base {
    :global(*),
    :global(*::before),
    :global(*::after) {
      box-sizing: border-box;
    }

    /* The two declarations that used to sit inline on <html>. The surfaces are
       theme tokens now, so there is nothing left to declare there, and the
       shell colour is kept on the root as well as on <body> so an overscroll
       past the body still paints page colour rather than white. */
    :global(html) {
      color-scheme: dark;
      background-color: var(--color-shell);
    }

    :global(body) {
      margin: 0;
      font-size: 0.875rem;
      line-height: 1.55;
    }

    :global(h1),
    :global(h2),
    :global(h3),
    :global(p),
    :global(pre),
    :global(figure),
    :global(figcaption),
    :global(ul),
    :global(ol),
    :global(dl),
    :global(dd) {
      margin: 0;
      font-size: inherit;
      font-weight: inherit;
    }

    :global(ul),
    :global(ol) {
      padding: 0;
      list-style: none;
    }

    :global(a) {
      color: inherit;
      text-decoration: none;
    }

    :global(button) {
      appearance: none;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      color: inherit;
      font: inherit;
      text-align: inherit;
      cursor: pointer;
    }

    :global(table) {
      width: 100%;
      border-collapse: collapse;
    }

    :global(th) {
      font-weight: inherit;
      text-align: left;
    }

    :global(pre),
    :global(code) {
      font-family: var(--font-mono);
    }

    :global(code) {
      color: var(--color-gray-100);
    }

    :global(p code),
    :global(li code),
    :global(td code),
    :global(dd code) {
      padding: 0.05em 0.3em;
      background-color: var(--color-raise);
    }

    :global(:focus-visible) {
      outline: 1px solid var(--color-accent-200);
      outline-offset: 2px;
    }

    :global(::selection) {
      background-color: var(--color-accent-900);
      color: var(--color-gray-100);
    }
  }

  /* Unlayered, so it overrides anything a utility asks for. */
  @media (prefers-reduced-motion: reduce) {
    :global(*),
    :global(*::before),
    :global(*::after) {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

---
// The eleven tools `ladygraph serve` registers, with the description each one
// registers, copied from a `tools/list` capture. `get_unresolved_references`
// exists in the source tree and is not registered, so it is not here.
interface Route {
  question: string;
  tool: string;
  description: string;
  /** Set on the one tool that writes. */
  gated?: boolean;
}

const routes: Route[] = [
  {
    question: "who calls this, what references this",
    tool: "find_references",
    description:
      "Who calls or references a symbol. Type-checked, not name-matched: grep cannot separate homonyms, and an empty answer means nobody calls it. A rare name in one repository is cheaper to grep.",
  },
  {
    question: "what breaks if I change it",
    tool: "get_blast_radius",
    description:
      "What a change to this symbol reaches, by repository, package, depth and relation kind. Grep does not follow a chain.",
  },
  {
    question: "what does this reach outward",
    tool: "trace_dependencies",
    description:
      "What this symbol reaches outward, bounded by depth. Grep does not follow a chain.",
  },
  {
    question: "who uses it from another repository",
    tool: "find_cross_repo_consumers",
    description:
      "Consumers of a symbol in other repositories, exact uses kept apart from package-level dependencies. A language server stops at its workspace.",
  },
  {
    question: "where is it declared",
    tool: "find_symbol",
    description:
      "Where a symbol is declared, by name, qualified name, prefix or substring. Narrow with kind, repo and path_prefix. A unique name in one repository is cheaper to grep.",
  },
  {
    question: "what is declared in this package",
    tool: "get_file_outline",
    description:
      "Declarations under a path, grouped by file, with kind, signature and range. Use it for a package; one small file is cheaper to read.",
  },
  {
    question: "give me the code of these symbols",
    tool: "get_source",
    description:
      "The code of several symbols in one call. Prefer it to reading each range: no line numbers, one call across files and repositories.",
  },
  {
    question: "everything about this one symbol",
    tool: "get_symbol",
    description:
      "One symbol's package, signature, visibility and line range, by stable key or by repository, path and qualified name.",
  },
  {
    question: "what is indexed, and at which commit",
    tool: "list_repositories",
    description:
      "The repositories the published graph covers, with the commit each was indexed at.",
  },
  {
    question: "is the graph current",
    tool: "graph_status",
    description:
      "The published generation: counts, provenance, and whether a repository moved since it was indexed. Call it when an answer looks stale.",
  },
  {
    question: "register a project and rebuild the graph",
    tool: "index_project",
    gated: true,
    description:
      "Registers projects and rebuilds the graph once, after explicit user approval. Pass every project in one call: a rebuild costs the whole corpus. It never writes inside the source projects.",
  },
];
---

<div class="overflow-x-auto">
  <table class="text-xs">
    <thead>
      <tr class="border-b border-rule-strong text-gray-400">
        <th scope="col" class="py-2 pr-6 md:w-56">the question</th>
        <th scope="col" class="py-2 pr-6 md:w-52">the tool</th>
        <th scope="col" class="hidden py-2 md:table-cell"
          >the description the server registers</th
        >
      </tr>
    </thead>
    <tbody>
      {
        routes.map((route) => (
          <tr class="border-b border-rule align-top">
            <td class="py-3 pr-6 text-gray-300">{route.question}</td>
            <td class="py-3 pr-6 whitespace-nowrap text-accent-200">
              {route.tool}
              {route.gated === true && (
                <span class="mt-3 block text-gray-400">consent-gated</span>
              )}
            </td>
            <td class="hidden py-3 text-gray-400 md:table-cell">
              {route.description}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<div
  class="mt-3 grid grid-cols-1 gap-x-10 gap-y-3 text-xs text-gray-400 lg:grid-cols-2"
>
  <p class="max-w-[68ch]">
    Ten read-only tools, plus one consent-gated mutation. Every tool that names
    a symbol takes either a <code>stable_key</code> or the triple <code
      >repository</code
    > + <code>path</code> + <code>qualified_name</code>, and exactly one of the
    two; <code>path</code> is repository-relative.
  </p>
  <p class="max-w-[68ch]">
    With no published generation, <code>serve</code> completes the handshake and
    registers <code>index_project</code> alone. The other ten appear once a
    generation is published.
  </p>
</div>

<p class="mt-5 text-xs">
  <a
    href="/reference/mcp-tools/"
    class="text-accent-200 underline underline-offset-4">the tool reference</a
  >
</p>

---
interface Props {
  value: string;
  label?: string;
  /**
   * Replaces the default chrome outright rather than adding to it. A caller
   * that wants this button to read as one of the hero's actions has to restate
   * the padding and the border too, and letting it append would have left the
   * `w-16` of the default behind -- wide enough for `copied` and nothing else.
   */
  class?: string;
  /**
   * The analytics event a successful copy reports, if the copy is worth
   * reporting. Every copy button on this site is worth it: copying a command or
   * the agent prompt is the strongest intent signal the page can observe, since
   * the next step happens in a terminal this site cannot see.
   *
   * It is optional so a button can opt out rather than opt in by accident, and
   * the name is the caller's because only the caller knows which of the six
   * buttons it is. See `docs/development/analytics.md` for the vocabulary.
   */
  event?: string;
  /**
   * Flat, non-personal properties for that event -- which install command, which
   * client, which step. Values are strings because that is what a report groups
   * by. Nothing here may identify a person.
   */
  eventData?: Readonly<Record<string, string>>;
}

const {
  value,
  label = "copy",
  class:
    className = "w-16 shrink-0 border border-rule-strong py-1 text-center text-xs text-gray-300 transition-colors hover:bg-raise hover:text-gray-100",
  event,
  eventData,
} = Astro.props;
---

<button
  type="button"
  data-copy={value}
  data-copy-event={event}
  data-copy-data={eventData === undefined ? undefined : JSON.stringify(eventData)}
  class={className}>{label}</button
>

<script>
  import { track } from "../../lib/analytics";
  import type { AnalyticsEvent, AnalyticsProperties } from "../../lib/analytics";

  // One listener per button, wired once for every copy button on the page.
  const RESET_MS = 1500;

  const buttons = Array.from(document.querySelectorAll("button[data-copy]"));

  for (const node of buttons) {
    if (!(node instanceof HTMLButtonElement)) {
      continue;
    }

    const button = node;
    const value = button.dataset.copy;
    if (value === undefined) {
      continue;
    }

    const label = button.textContent ?? "copy";
    const eventName = button.dataset.copyEvent as AnalyticsEvent | undefined;
    let eventData: AnalyticsProperties | undefined;
    if (button.dataset.copyData !== undefined) {
      try {
        eventData = JSON.parse(button.dataset.copyData) as AnalyticsProperties;
      } catch {
        eventData = undefined;
      }
    }

    button.addEventListener("click", () => {
      navigator.clipboard.writeText(value).then(
        () => {
          button.textContent = "copied";
          window.setTimeout(() => {
            button.textContent = label;
          }, RESET_MS);
          // Reported on success only. A copy the clipboard refused is not an
          // intent the reader expressed, and counting it would inflate the one
          // conversion this site has.
          //
          // `track()` and not a provider: this component does not know which
          // analytics exist, which is what lets one be added or removed without
          // touching a button.
          if (eventName !== undefined) {
            track(eventName, eventData);
          }
        },
        () => {
          button.textContent = "failed";
        },
      );
    });
  }
</script>

---
// The nav is generated, so whether a link leaves the site is read off its own
// `href` rather than repeated per row: a new entry cannot forget the rule.
const links = [
  { href: "#value", label: "why it matters" },
  { href: "#answers", label: "what it answers" },
  { href: "#faq", label: "FAQ" },
  { href: "/quickstart/", label: "quickstart" },
  { href: "/docs/mcp-tools/", label: "docs" },
  { href: "https://github.com/Luqueee/kivgraph", label: "github" },
].map((link) => ({
  ...link,
  external: /^https?:\/\//.test(link.href),
}));
---

<header class="border-b border-rule">
  <div
    class="mx-auto box-border flex w-full max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-3 text-xs"
  >
    <a href="/" class="flex items-center gap-2 text-gray-100">
      <span class="inline-block h-2 w-2 bg-graph-repository" aria-hidden="true"
      ></span>
      kivgraph
    </a>
    <span class="text-gray-400">cross-repository code intelligence</span>
    <nav
      class="ml-auto flex flex-wrap items-center gap-x-6 gap-y-2"
      aria-label="Primary"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="text-gray-400 underline-offset-4 transition-colors hover:text-gray-100 hover:underline"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

---
import InstallCommand from "./InstallCommand.astro";
import { CLIENTS } from "./clients";

const facts = [
  "local only",
  "MCP over stdio",
  "no model, no API key",
  "Apache-2.0",
];
---

<section class="stage" data-hero>
  <div class="plane" data-hero-field aria-hidden="true"></div>
  <div class="veil" aria-hidden="true"></div>
  <!-- The halo is declared here rather than created by the motion layer:
    an element appended at runtime carries no scope attribute, so this
    component's scoped CSS would not reach it. It rests invisible because it
    holds no content -- if the module never runs there is nothing to reveal. -->
  <div class="halo" data-hero-halo aria-hidden="true"></div>

  <div
    class="mx-auto box-border w-full max-w-6xl px-6 py-20 text-center sm:py-24"
  >
    <p
      data-hero-item="eyebrow"
      class="font-mono text-xs tracking-[0.16em] text-gray-400 uppercase"
    >
      semantic code intelligence for coding agents
    </p>
    {/* `max-w-4xl`, not the `max-w-3xl` the prose below uses, and a size that
      steps twice rather than once. A monospaced face sets far wider than a
      proportional one, so 48px only fits this sentence in two lines once the
      column is past 52rem: at 48rem, and at the 720px a tablet leaves, it broke
      into three with `it.` alone on the last. 4xl covers that middle. */}
    <h1
      data-hero-item="title"
      class="mx-auto mt-6 max-w-4xl font-mono text-3xl leading-tight font-medium tracking-tight text-gray-100 sm:text-4xl lg:text-5xl"
    >
      Know what breaks before your coding agent changes it.
    </h1>
    <p
      data-hero-item="lede"
      class="mx-auto mt-6 max-w-2xl text-sm leading-6 text-gray-300"
    >
      Kivgraph gives Claude Code, Codex and other coding agents exact symbol
      references, dependency paths and cross-repository change impact — from a
      graph on your own machine, over MCP. When you do not know the symbol's
      name, start with <code>find_by_intent</code>: ask in plain language and get
      ranked files to open.
    </p>

    <div
      data-hero-item="actions"
      class="mt-10 flex flex-wrap items-center justify-center gap-3 font-mono text-xs"
    >
      {/* Two actions keep the hierarchy legible: discover the entry-point tool,
        or install Kivgraph. The command copy control belongs to the install
        block below, where it has the context needed to use it. */}
      <a
        href="#ask-without-a-name"
        class="border border-graph-exact bg-graph-exact px-4 py-2 text-shell transition-colors hover:border-gray-100 hover:bg-gray-100"
        >try find_by_intent</a
      >
      <a
        href="/install/"
        class="border border-graph-exact bg-raise px-4 py-2 text-gray-100 transition-colors hover:border-gray-700"
        >install Kivgraph</a
      >
    </div>

    <p data-hero-item="agents" class="mt-8 font-mono text-xs text-gray-400">
      <span class="sr-only">Supported MCP clients: </span>
      {
        CLIENTS.map((client, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            {client.label}
          </>
        ))
      }
    </p>

    <div data-hero-item="install" class="mx-auto mt-12 max-w-2xl">
      <InstallCommand where="hero" />
    </div>

    <ul
      data-hero-item="facts"
      class="mt-8 flex flex-wrap justify-center gap-y-2 font-mono text-xs text-gray-400"
    >
      {
        facts.map((fact) => (
          <li class="mx-3 border-l border-rule-strong pl-3 first:border-l-0 first:pl-0">
            {fact}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The backdrop is CSS and nothing else: a static grid and one highlight that
     travels over it. It replaces a 2D canvas that cost 415 lines, a
     `requestAnimationFrame` loop, a `ResizeObserver`, an `IntersectionObserver`
     and a palette read out of the cascade, and drew a field whose node
     positions encoded no relation in the graph.

     There is deliberately no border-bottom on the stage: the first Section band
     draws its own border-top, and two adjacent hairlines read as one 2px rule
     that no other seam on the page has. */
  .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  /* The structure never moves. The mask dissolves it before it reaches any
     edge, which is what keeps it a backdrop rather than a texture with a
     border of its own. */
  .plane {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      repeating-linear-gradient(
        to right,
        var(--color-rule-strong) 0 1px,
        transparent 1px 72px
      ),
      repeating-linear-gradient(
        to bottom,
        var(--color-rule-strong) 0 1px,
        transparent 1px 72px
      );
    -webkit-mask-image: radial-gradient(
      ellipse 76% 66% at 50% 50%,
      #000 0%,
      transparent 80%
    );
    mask-image: radial-gradient(
      ellipse 76% 66% at 50% 50%,
      #000 0%,
      transparent 80%
    );
  }

  /* The sheen is the grid's own `::after` so the grid's mask clips it too: a
     sibling would light the band's edges the mask exists to hide. It
     ping-pongs rather than looping, so there is no restart to disguise -- a
     one-way sweep would snap back to its starting position every 15s. */
  .plane::after {
    position: absolute;
    content: "";
    inset: -50% -100%;
    background: linear-gradient(
      100deg,
      transparent 42%,
      color-mix(in oklab, var(--color-gray-100) 7%, transparent) 50%,
      transparent 58%
    );
    /* The duration is a variable so an entrance animation can borrow the loop
       for one fast pass and then hand it back by removing the property. */
    animation: sheen var(--sheen-duration, 15s) ease-in-out infinite alternate;
  }

  @keyframes sheen {
    from {
      translate: -34% 0;
    }
    to {
      translate: 34% 0;
    }
  }

  /* The veil is a seam, not a scrim: it closes the pattern at the band's edges
     so it never butts against the header's hairline. A wash heavy enough to
     "protect" the copy erases the grid instead; 1px lines at `rule-strong` do
     not compete with text at any weight here. */
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 56% 46% at 50% 44%,
        color-mix(in oklab, var(--color-shell) 28%, transparent),
        transparent 72%
      ),
      linear-gradient(to bottom, var(--color-shell) 0%, transparent 9%),
      linear-gradient(to top, var(--color-shell) 0%, transparent 11%);
  }

  /* The pointer halo. It is a figure, not a control: no pointer events, and a
     radius large enough that the grid under it reads as lit rather than as
     spotlit. The motion layer translates it and fades it in; a page without
     that module keeps it at zero and loses nothing. */
  .halo {
    position: absolute;
    top: 0;
    left: 0;
    width: 22rem;
    height: 22rem;
    margin: -11rem 0 0 -11rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-graph-repository) 24%, transparent),
      transparent 68%
    );
    filter: blur(30px);
    opacity: 0;
    pointer-events: none;
    z-index: -1;
  }

  @media (prefers-reduced-motion: reduce) {
    .plane::after {
      animation: none;
    }
  }
</style>

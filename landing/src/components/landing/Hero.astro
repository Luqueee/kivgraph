---
import CopyButton from "./CopyButton.astro";
import TokenSaving from "./TokenSaving.astro";

const installCommand =
  "curl -fsSL https://github.com/Luqueee/kivgraph/releases/latest/download/install.sh | bash";

const facts = [
  "local only",
  "MCP over stdio",
  "11 tools, ten read-only",
  "linux/amd64, darwin/arm64",
  "Apache-2.0",
];

// One published generation, as `graph_status` reported it on 2026-08-15.
const readout = [
  ["repositories", "2"],
  ["packages", "57"],
  ["files", "311"],
  ["symbols", "10,957"],
  ["edges", "40,125"],
  ["unresolved", "1,642"],
];
---

<section class="stage">
  <div class="plane" data-hero-field aria-hidden="true"></div>
  <div class="veil" aria-hidden="true"></div>

  <div
    class="mx-auto box-border w-full max-w-6xl px-6 py-20 text-center sm:py-24"
  >
    <h1
      class="mx-auto max-w-3xl text-3xl leading-tight font-medium tracking-tight text-gray-100 sm:text-5xl"
    >
      Local cross-repository code intelligence for AI coding agents
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-sm leading-6 text-gray-300">
      Kivgraph builds a canonical semantic code graph for Go, TypeScript, Rust,
      Python and Dart repositories and serves repository relationships,
      references and change impact to MCP clients over stdio.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-xs">
      <a
        href="/install/"
        class="border border-rule-strong bg-raise px-4 py-2 text-gray-100 transition-colors hover:border-gray-700"
        >install guide →</a
      >
      <a
        href="https://github.com/Luqueee/kivgraph"
        target="_blank"
        rel="noopener noreferrer"
        class="border border-rule px-4 py-2 text-gray-300 transition-colors hover:border-rule-strong hover:text-gray-100"
        >github.com/Luqueee/kivgraph</a
      >
    </div>

    <div class="mx-auto mt-12 max-w-2xl border border-rule bg-panel text-left">
      <div
        class="flex items-center justify-between gap-4 border-b border-rule px-4 py-2 text-xs text-gray-400"
      >
        <span>install the latest release</span>
        <CopyButton value={installCommand} />
      </div>
      <pre
        class="px-4 py-3 text-xs leading-5 whitespace-pre-wrap break-all"><code><span class="text-graph-exact select-none">$ </span>{installCommand}</code></pre>
    </div>

    <div class="mx-auto mt-8 max-w-2xl text-left">
      <TokenSaving />
    </div>

    <ul
      class="mt-12 flex flex-wrap justify-center gap-y-2 text-xs text-gray-400"
    >
      {
        facts.map((fact) => (
          <li class="mx-3 border-l border-rule-strong pl-3 first:border-l-0 first:pl-0">
            {fact}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="relative border-t border-rule">
    <div
      class="mx-auto box-border flex w-full max-w-6xl flex-wrap items-baseline gap-x-6 gap-y-2 px-6 py-3 text-xs"
    >
      <dl class="flex flex-wrap gap-x-6 gap-y-2">
        {
          readout.map(([label, value]) => (
            <div class="flex items-baseline gap-2">
              <dt class="text-gray-400">{label}</dt>
              <dd class="text-gray-100">{value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="text-gray-400">
        one published generation, as <code>graph_status</code> reports it; the
        references it could not resolve are counted, not hidden
      </p>
    </div>
  </div>
</section>

<style>
  /* The backdrop is CSS and nothing else: a static grid and one highlight that
     travels over it. It replaces a 2D canvas that cost 415 lines, a
     `requestAnimationFrame` loop, a `ResizeObserver`, an `IntersectionObserver`
     and a palette read out of the cascade, and drew a field whose node
     positions encoded no relation in the graph.

     There is deliberately no border-bottom on the stage: the first Section band
     draws its own border-top, and two adjacent hairlines read as one 2px rule
     that no other seam on the page has. */
  .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  /* The structure never moves. The mask dissolves it before it reaches any
     edge, which is what keeps it a backdrop rather than a texture with a
     border of its own. */
  .plane {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      repeating-linear-gradient(
        to right,
        var(--color-rule-strong) 0 1px,
        transparent 1px 72px
      ),
      repeating-linear-gradient(
        to bottom,
        var(--color-rule-strong) 0 1px,
        transparent 1px 72px
      );
    -webkit-mask-image: radial-gradient(
      ellipse 76% 66% at 50% 50%,
      #000 0%,
      transparent 80%
    );
    mask-image: radial-gradient(
      ellipse 76% 66% at 50% 50%,
      #000 0%,
      transparent 80%
    );
  }

  /* The sheen is the grid's own `::after` so the grid's mask clips it too: a
     sibling would light the band's edges the mask exists to hide. It
     ping-pongs rather than looping, so there is no restart to disguise -- a
     one-way sweep would snap back to its starting position every 15s. */
  .plane::after {
    position: absolute;
    content: "";
    inset: -50% -100%;
    background: linear-gradient(
      100deg,
      transparent 42%,
      color-mix(in oklab, var(--color-gray-100) 7%, transparent) 50%,
      transparent 58%
    );
    animation: sheen 15s ease-in-out infinite alternate;
  }

  @keyframes sheen {
    from {
      translate: -34% 0;
    }
    to {
      translate: 34% 0;
    }
  }

  /* The veil is a seam, not a scrim: it closes the pattern at the band's edges
     so it never butts against the header's hairline. A wash heavy enough to
     "protect" the copy erases the grid instead; 1px lines at `rule-strong` do
     not compete with text at any weight here. */
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 56% 46% at 50% 44%,
        color-mix(in oklab, var(--color-shell) 28%, transparent),
        transparent 72%
      ),
      linear-gradient(to bottom, var(--color-shell) 0%, transparent 9%),
      linear-gradient(to top, var(--color-shell) 0%, transparent 11%);
  }

  @media (prefers-reduced-motion: reduce) {
    .plane::after {
      animation: none;
    }
  }
</style>

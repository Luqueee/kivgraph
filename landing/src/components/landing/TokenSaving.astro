---
// The bars are derived from the numbers, never sized by hand: a chart whose
// geometry contradicts its own figures argues against the claim it is there to
// make. Both bars used to run the full width, so 6,200 and 63,531 drew the same
// length.
const rows = [
  { label: "Kivgraph graph query", tokens: 6200, ours: true },
  { label: "grep + file reading", tokens: 63531, ours: false },
];

const format = new Intl.NumberFormat("en-US");
const peak = Math.max(...rows.map((row) => row.tokens));
const ours = rows.find((row) => row.ours)?.tokens ?? 0;
const saved = Math.round((1 - ours / peak) * 100);

/**
 * Milliseconds before the first bar starts, and between one bar and the next.
 * The lead-in matters: a bar that grows while the hero is still painting is a
 * motion nobody sees, and the comparison is the one thing on this card worth
 * watching happen.
 */
const LEAD_IN_MS = 420;
const STAGGER_MS = 160;

/**
 * The length of a bar is the measurement; its pace is the argument. Ours snaps
 * and settles, grep's grinds on at a constant rate for five times as long, so
 * the cost is felt before the number beside it is read. Only the widths are
 * derived from the data -- inventing a duration from the token count would put
 * a `10.2x` figure on screen that no benchmark measured.
 */
const PACE = {
  ours: { duration: 700, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
  theirs: { duration: 3600, easing: "linear" },
} as const;
---

<div
  class="border border-graph-exact bg-panel p-4"
  aria-label={`Measured token comparison: ${rows
    .map((row) => `${row.label} ${format.format(row.tokens)} tokens`)
    .join(", ")}`}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-xs font-medium tracking-[0.16em] text-gray-300 uppercase">
      context saved
    </p>
    <p class="text-xs text-graph-exact">~{saved}% fewer tokens</p>
  </div>

  <div class="mt-4 grid grid-cols-[1fr_auto] items-end gap-x-4 gap-y-2 text-xs">
    {
      rows.map((row, index) => (
        <>
          <div>
            <div
              class:list={[
                "flex items-center justify-between gap-3",
                row.ours ? "text-gray-300" : "text-gray-400",
              ]}
            >
              <span>{row.label}</span>
              <strong
                class:list={[
                  "font-medium",
                  row.ours ? "text-gray-100" : "text-gray-300",
                ]}
              >
                {format.format(row.tokens)}
              </strong>
            </div>
            <div class="mt-2 h-2 bg-raise">
              <div
                class:list={[
                  "fill h-full",
                  row.ours ? "bg-graph-exact" : "bg-gray-500",
                ]}
                style={[
                  `width: ${((row.tokens / peak) * 100).toFixed(2)}%`,
                  `animation-delay: ${LEAD_IN_MS + index * STAGGER_MS}ms`,
                  `animation-duration: ${(row.ours ? PACE.ours : PACE.theirs).duration}ms`,
                  `animation-timing-function: ${(row.ours ? PACE.ours : PACE.theirs).easing}`,
                ].join("; ")}
              />
            </div>
          </div>
          <span class="text-gray-400">tokens</span>
        </>
      ))
    }
  </div>

  <p class="mt-4 text-[0.7rem] leading-5 text-gray-400">
    One seven-question benchmark: all 7 exact answers, measured against the
    host's captured grep-and-read output. <a
      href="/comparison/"
      class="text-accent-200 underline underline-offset-4">See the method</a
    >.
  </p>
</div>

<style>
  /* A load-time animation belongs in CSS, not in the deferred motion module:
     that script can run after the first paint, and the bar would be seen at
     full width before collapsing to grow again. `scaleX` from the left edge
     touches no layout, so a growing bar cannot shift the rows beside it, and
     `both` holds the collapsed state through the delay. */
  /* The duration and the easing arrive per row from `PACE`, so this rule only
     names what both bars share. */
  .fill {
    transform-origin: left center;
    animation-name: fill-grow;
    animation-fill-mode: both;
  }

  @keyframes fill-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fill {
      animation: none;
    }
  }
</style>

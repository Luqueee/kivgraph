---
import Agents from "../components/landing/Agents.astro";
import AskWithoutName from "../components/landing/AskWithoutName.astro";
import CrossRepo from "../components/landing/CrossRepo.astro";
import Faq from "../components/landing/Faq.astro";
import FinalCta from "../components/landing/FinalCta.astro";
import Footer from "../components/landing/Footer.astro";
import GrepTable from "../components/landing/GrepTable.astro";
import Hero from "../components/landing/Hero.astro";
import Languages from "../components/landing/Languages.astro";
import Layout from "../components/landing/Layout.astro";
import Measured from "../components/landing/Measured.astro";
import NameNotSymbol from "../components/landing/NameNotSymbol.astro";
import ProductProof from "../components/landing/ProductProof.astro";
import Quickstart from "../components/landing/Quickstart.astro";
import Section from "../components/landing/Section.astro";
import TopBar from "../components/landing/TopBar.astro";
import Viewer from "../components/landing/Viewer.astro";

// The order is the argument, and it runs in one direction: you cannot name it
// yet -> here is a symbol I want to change -> here is the measurement -> here
// is what a resolved graph says about it -> here is why a text search cannot
// say the same thing -> here is what a name really is -> the relationships
// cross repositories -> it plugs into the agent you already run -> install it.
//
// The measurement leads the demo since 2026-08-27, and the argument for the
// order before it is worth keeping: measuring before showing what is measured
// asks the reader to accept a figure about something they have not seen, and
// the `grep` band that follows leans on the measurement rather than on the
// demo. What the current order buys is that the first concrete thing under the
// hero is a number and not a capture. Moving it back moves three things: this
// comment, the sections below and `landing/AGENTS.md`.
//
// The first band is unnumbered on purpose. It answers the question a visitor
// arrives with rather than one of the questions the numbered argument makes,
// and numbering it would have renumbered five bands to say so.
//
// What is deliberately *not* here is a list of the twelve tools. A visitor is
// asking what their agent will be able to understand, not which functions the
// server exports; the tool reference is a page of its own and every section
// below links into it where the question comes up.

// `output: "server"` makes on-demand rendering the default for src/pages, and
// there is nothing dynamic on this page.
export const prerender = true;
---

<Layout
  title="Kivgraph: code intelligence MCP server for AI coding agents"
  description="Kivgraph gives Claude Code, Codex and other AI coding agents exact symbol references, dependency paths and cross-repository change impact, over MCP."
>
  <TopBar />
  <main id="main">
    <Hero />
    <AskWithoutName />
    <Section index="01" title="less context, same exact answer" id="measured">
      <Measured />
    </Section>
    <Section index="02" title="what your agent can ask" id="proof">
      <ProductProof />
    </Section>
    <Section
      index="03"
      title="grep finds text, Kivgraph resolves symbols"
      id="not-grep"
    >
      <GrepTable />
    </Section>
    <Section index="04" title="a name is not a symbol" id="resolution">
      <NameNotSymbol />
    </Section>
    <Section
      index="05"
      title="your repositories are not isolated"
      id="cross-repository"
    >
      <CrossRepo />
    </Section>
    <Section index="06" title="works where you already code" id="agents">
      <Agents />
    </Section>
    <Section index="07" title="start with your workspace" id="quickstart">
      <Quickstart />
    </Section>
    <Section index="08" title="languages" id="languages">
      <Languages />
    </Section>
    <Section index="09" title="see what the agent sees" id="viewer">
      <Viewer />
    </Section>
    <Section index="10" title="frequently asked questions" id="faq">
      <Faq />
    </Section>
    <FinalCta />
  </main>
  <Footer />
</Layout>

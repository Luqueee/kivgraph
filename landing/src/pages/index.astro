---
import Faq from "../components/landing/Faq.astro";
import Footer from "../components/landing/Footer.astro";
import Hero from "../components/landing/Hero.astro";
import Highlights from "../components/landing/Highlights.astro";
import Layout from "../components/landing/Layout.astro";
import Routing from "../components/landing/Routing.astro";
import Quickstart from "../components/landing/Quickstart.astro";
import Section from "../components/landing/Section.astro";
import TopBar from "../components/landing/TopBar.astro";

// `output: "server"` makes on-demand rendering the default for src/pages, and
// there is nothing dynamic on this page.
export const prerender = true;
---

<Layout
  title="Kivgraph: code intelligence MCP server for AI coding agents"
  description="Kivgraph is a local code intelligence MCP server that maps repository relationships, resolves code references, and gives Claude Code, Codex and other AI coding agents fewer, better tool calls."
>
  <TopBar />
  <main id="main">
    <Hero />
    <Section index="01" title="why teams use it" id="value">
      <Highlights />
    </Section>
    <Section index="02" title="what it answers" id="answers">
      <Routing />
    </Section>
    <Section index="03" title="start with your workspace" id="quickstart">
      <p class="max-w-[68ch] text-sm leading-6 text-gray-300">
        Register the repositories that make up your workspace, publish one
        canonical graph, and connect your MCP client. Then ask about symbols,
        repository relationships and change impact.
      </p>
      <div class="mt-10">
        <Quickstart />
      </div>
    </Section>
    <Section index="04" title="frequently asked questions" id="faq">
      <Faq />
    </Section>
  </main>
  <Footer />
</Layout>

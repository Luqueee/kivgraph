---
// A preview surface, not a published page: it exists to choose the hero field
// by looking at the candidates side by side. It deliberately does not use
// Layout.astro -- that shell emits the site's JSON-LD graph and the canonical
// of a real page, and a preview URL must claim neither. `noindex` is stated
// here for the same reason.
//
// Delete this route, `src/lib/hero-variants.ts` and the exports it borrows from
// `hero-graph.ts` once the hero is decided.
import "../styles/global.css";

const variants = [
  {
    key: "ripple",
    label: "A",
    title: "Impact radius",
    body: "One symbol at the centre, concentric rings by hop count, every edge radial. get_blast_radius drawn literally. Two edges cannot cross: a child never leaves its parent's bearing.",
  },
  {
    key: "layers",
    label: "B",
    title: "Layered dependency graph",
    body: "Repository, package, symbol as three columns. Every edge is monotone left to right, so crossings are impossible by construction. The shape a monorepo task graph already uses.",
  },
  {
    key: "clusters",
    label: "C",
    title: "Three clusters",
    body: "Containment stays a faint texture and only the cross-repository edges are lit. Keeps the constellation feel of the current field, with structure under it.",
  },
  {
    key: "spine",
    label: "D",
    title: "One traced path",
    body: "A component reaching the handler that serves it, with the rest of the graph quiet around it. One head travels the whole chain, because the claim is the path.",
  },
] as const;

export const prerender = true;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero field variants — Kivgraph</title>
  </head>
  <body class="min-h-screen bg-shell font-mono text-gray-100 antialiased">
    <header class="border-b border-rule">
      <div class="mx-auto box-border w-full max-w-6xl px-6 py-6">
        <h1 class="text-lg font-medium tracking-tight text-gray-100">
          Hero field variants
        </h1>
        <p class="mt-3 max-w-[68ch] text-sm text-gray-300">
          Four candidates for the hero graph, plus the field currently shipped.
          Each one is deterministic: the positions come from the structure, not
          from a hash of the node index. Cadence and density are tunable — judge
          the layout and the kind of motion, not the exact speed.
        </p>
        <p class="mt-3 text-xs text-gray-400">
          This page is <code>noindex</code> and is deleted once the hero is
          chosen.
        </p>
      </div>
    </header>

    <main class="mx-auto box-border w-full max-w-6xl px-6 py-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
        {
          variants.map((variant) => (
            <section class="border border-rule bg-panel">
              <div
                class="flex items-baseline gap-3 border-b border-rule px-4 py-3"
              >
                <span class="text-xs text-gray-400">{variant.label}</span>
                <h2 class="text-sm font-medium text-gray-100">
                  {variant.title}
                </h2>
              </div>
              <canvas
                class="field"
                data-variant={variant.key}
                role="img"
                aria-label={variant.title}
              />
              <p class="border-t border-rule px-4 py-3 text-xs leading-5 text-gray-400">
                {variant.body}
              </p>
            </section>
          ))
        }

        <section class="border border-rule-strong bg-panel">
          <div class="flex items-baseline gap-3 border-b border-rule px-4 py-3">
            <span class="text-xs text-gray-400">—</span>
            <h2 class="text-sm font-medium text-gray-100">
              Currently shipped, for reference
            </h2>
          </div>
          <canvas
            id="hero-current"
            class="field"
            role="img"
            aria-label="The hero field currently in production"></canvas>
          <p
            class="border-t border-rule px-4 py-3 text-xs leading-5 text-gray-400"
          >
            Orbital layout with hash jitter: a node's position encodes no
            relation, so the crossings carry no meaning. This is the one being
            replaced.
          </p>
        </section>
      </div>
    </main>

    <style>
      /* Both axes are stated. Leaving one to the intrinsic size lets the
         drawing buffer feed back into the element box and the canvas grows
         without bound. */
      .field {
        display: block;
        width: 100%;
        height: 380px;
      }
    </style>

    <script>
      import { startHeroGraph } from "../lib/hero-graph";
      import { mountVariant, type VariantName } from "../lib/hero-variants";

      for (const canvas of document.querySelectorAll("canvas[data-variant]")) {
        const variant = canvas.getAttribute("data-variant");
        if (canvas instanceof HTMLCanvasElement && variant !== null) {
          mountVariant(canvas, variant as VariantName);
        }
      }

      const current = document.getElementById("hero-current");
      if (current instanceof HTMLCanvasElement) {
        startHeroGraph(current);
      }
    </script>
  </body>
</html>

---
// A preview surface, not a published page: it exists to choose the hero by
// looking at the candidates instead of describing them. It deliberately does
// not use Layout.astro -- that shell emits the site's JSON-LD graph and the
// canonical of a real page, and a preview URL must claim neither. `noindex`
// keeps it out of search; it is absent from `llms.txt` because that endpoint
// lists the `docs` collection, which this route is not part of.
//
// Delete this route once the hero is decided.
import "../styles/global.css";
import CopyButton from "../components/landing/CopyButton.astro";
import TokenSaving from "../components/landing/TokenSaving.astro";

const installCommand =
  "curl -fsSL https://github.com/Luqueee/kivgraph/releases/latest/download/install.sh | bash";

// Two families and their crossings. Every candidate is CSS: repeating
// gradients on one or two planes, one `animation` each, no canvas and no
// script.
const families = [
  {
    title: "D - drifting beams",
    note: "Soft columns crossing the band. The variables are how many, how wide, how much hue and how fast.",
    variants: [
      {
        id: "beams-wide",
        label: "D1 - three columns",
        note: "The original: repository blue, package purple and one neutral, wide and slow.",
        layers: 1,
      },
      {
        id: "beams-tight",
        label: "D2 - tighter and steeper",
        note: "Narrower columns at a steeper angle, so the movement reads as travel across the band rather than as a wash sitting on it.",
        layers: 1,
      },
      {
        id: "beams-single",
        label: "D3 - one broad sweep",
        note: "A single repository-blue column, wide enough to light half the band at a time. The quietest of the four.",
        layers: 1,
      },
      {
        id: "beams-breathe",
        label: "D4 - two hues, breathing",
        note: "Blue drifting one way, exact-green the other, with a glow that swells and fades. The loudest of the four.",
        layers: 2,
      },
    ],
  },
  {
    title: "E - grid with a sheen",
    note: "Structure that never moves and one highlight that travels over it. The variables are the tile, the brightness and the direction of the sweep.",
    variants: [
      {
        id: "sheen-base",
        label: "E1 - 72px tile, diagonal sweep",
        note: "The original: an even grid and a neutral highlight crossing at a shallow diagonal.",
        layers: 1,
      },
      {
        id: "sheen-fine",
        label: "E2 - 40px tile, faster",
        note: "A denser grid reads as graph paper rather than as architecture, and the sweep has to move faster to stay legible over it.",
        layers: 1,
      },
      {
        id: "sheen-coarse",
        label: "E3 - 128px tile, tinted sweep",
        note: "Fewer, larger cells and a repository-blue highlight. The tile is large enough that the copy sits inside one cell.",
        layers: 1,
      },
      {
        id: "sheen-nodes",
        label: "E4 - lit intersections, vertical sweep",
        note: "Brighter dots where the lines cross, and the highlight falling from the top instead of crossing. The intersections are the only thing that reads as a node.",
        layers: 1,
      },
    ],
  },
  {
    title: "D x E - both",
    note: "The grid carries the structure and the beams carry the hue. Two planes, so the order matters: behind the grid it tints the field, in front of it the grid is lit.",
    variants: [
      {
        id: "hybrid-lit-field",
        label: "H1 - beams behind the grid",
        note: "The grid stays neutral and the colour arrives from underneath, so no line ever changes hue.",
        layers: 2,
      },
      {
        id: "hybrid-lit-grid",
        label: "H2 - beams over the grid",
        note: "The beam lights the lines it crosses, which is the only candidate where the structure itself changes colour as the animation runs.",
        layers: 2,
      },
    ],
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero backdrop candidates</title>
  </head>
  <body class="min-h-screen bg-shell font-mono text-gray-100 antialiased">
    <header class="border-b border-rule-strong">
      <div class="mx-auto box-border w-full max-w-6xl px-6 py-4">
        <p class="text-sm text-gray-100">hero backdrop candidates</p>
        <p class="mt-2 max-w-[76ch] text-xs text-gray-400">
          The same centred hero ten times; only the backdrop differs. Every
          candidate is pure CSS: no canvas, no <code>
            requestAnimationFrame
          </code>, no observers, and one <code>animation</code> per plane that a
          <code>prefers-reduced-motion</code> query switches off. Each loop
          travels a whole number of pattern periods, so none of them snaps when
          it restarts.
        </p>
      </div>
    </header>

    <main>
      {
        families.map((family) => (
          <section>
            <div class="mx-auto box-border w-full max-w-6xl px-6 pt-10 pb-2">
              <h2 class="text-sm text-gray-100">{family.title}</h2>
              <p class="mt-2 max-w-[76ch] text-xs text-gray-400">
                {family.note}
              </p>
            </div>

            {family.variants.map((variant) => (
              <article class="border-b border-rule-strong">
                <div class="mx-auto box-border w-full max-w-6xl px-6 pt-6">
                  <p class="text-xs text-gray-100">{variant.label}</p>
                  <p class="mt-2 max-w-[76ch] text-xs text-gray-400">
                    {variant.note}
                  </p>
                </div>

                <div class="stage" data-backdrop={variant.id}>
                  <div class="plane" aria-hidden="true" />
                  {variant.layers === 2 && (
                    <div class="plane-b" aria-hidden="true" />
                  )}
                  <div class="veil" aria-hidden="true" />

                  <div class="mx-auto box-border w-full max-w-6xl px-6 py-20 text-center">
                    <h1 class="mx-auto max-w-3xl text-3xl leading-tight font-medium tracking-tight text-gray-100 sm:text-5xl">
                      Local cross-repository code intelligence for AI coding
                      agents
                    </h1>
                    <p class="mx-auto mt-6 max-w-2xl text-sm leading-6 text-gray-300">
                      Kivgraph builds a canonical semantic code graph for Go,
                      TypeScript, Rust, Python and Dart repositories and serves
                      repository relationships, references and change impact to
                      MCP clients over stdio.
                    </p>

                    <div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-xs">
                      <a
                        href="/install/"
                        class="border border-rule-strong bg-raise px-4 py-2 text-gray-100"
                      >
                        install guide →
                      </a>
                      <a
                        href="https://github.com/Luqueee/kivgraph"
                        class="border border-rule px-4 py-2 text-gray-300"
                      >
                        github.com/Luqueee/kivgraph
                      </a>
                    </div>

                    <div class="mx-auto mt-12 max-w-2xl border border-rule bg-panel text-left">
                      <div class="flex items-center justify-between gap-4 border-b border-rule px-4 py-2 text-xs text-gray-400">
                        <span>install the latest release</span>
                        <CopyButton value={installCommand} />
                      </div>
                      <pre class="px-4 py-3 text-xs leading-5 whitespace-pre-wrap break-all"><code><span class="text-graph-exact select-none">$ </span>{installCommand}</code></pre>
                    </div>

                    <div class="mx-auto mt-8 max-w-2xl text-left">
                      <TokenSaving />
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </section>
        ))
      }
    </main>

    <style>
      /* Every candidate shares the same layers: `.plane` carries the pattern,
         `.plane-b` is the second one the two-layer variants declare, and
         `.veil` closes the band's edges. */
      .stage {
        position: relative;
        isolation: isolate;
        overflow: hidden;
      }

      .plane,
      .plane-b {
        position: absolute;
        z-index: -2;
      }

      /* The veil is a seam, not a scrim. It only has to stop the pattern at the
         band's edges so it does not butt against the header's hairline; a wash
         heavy enough to "protect" the copy erases the pattern instead, which is
         how the first pass ended up with invisible backdrops. 1px lines at
         `rule-strong` do not compete with text at any weight on this page. */
      .veil {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
          radial-gradient(
            ellipse 56% 46% at 50% 44%,
            color-mix(in oklab, var(--color-shell) 28%, transparent),
            transparent 72%
          ),
          linear-gradient(to bottom, var(--color-shell) 0%, transparent 9%),
          linear-gradient(to top, var(--color-shell) 0%, transparent 11%);
      }

      /* ===================================================================
         D - drifting beams
         ===================================================================

         The beams are `repeating-linear-gradient`s on a horizontal axis, and
         the tilt comes from rotating the plane rather than from the gradient
         angle. That is what makes the loop seamless: a horizontal axis means a
         shift of one period in `background-position` is exactly one period of
         the pattern, while a tilted gradient would need the shift divided by
         `sin(angle)` and would snap on every restart.

         `scale` covers the corners the rotation exposes, and `blur` needs the
         plane to bleed past the band so its own soft edge never shows. */
      [data-backdrop^="beams"] .plane,
      [data-backdrop^="hybrid"] .plane-b {
        inset: -60% -30%;
        transform-origin: 50% 50%;
      }

      [data-backdrop="beams-wide"] .plane {
        background-image:
          repeating-linear-gradient(
            to right,
            transparent 0 90px,
            color-mix(in oklab, var(--color-graph-repository) 22%, transparent)
              230px,
            transparent 380px 520px
          ),
          repeating-linear-gradient(
            to right,
            transparent 0 140px,
            color-mix(in oklab, var(--color-graph-package) 18%, transparent)
              330px,
            transparent 500px 660px
          ),
          repeating-linear-gradient(
            to right,
            transparent 0 80px,
            color-mix(in oklab, var(--color-rule-strong) 90%, transparent) 200px,
            transparent 320px 420px
          );
        transform: rotate(-14deg) scale(1.5);
        filter: blur(22px);
        animation: beams-wide-drift 30s linear infinite;
      }

      @keyframes beams-wide-drift {
        from {
          background-position:
            0 0,
            0 0,
            0 0;
        }
        to {
          background-position:
            520px 0,
            -660px 0,
            420px 0;
        }
      }

      [data-backdrop="beams-tight"] .plane {
        background-image:
          repeating-linear-gradient(
            to right,
            transparent 0 40px,
            color-mix(in oklab, var(--color-graph-repository) 26%, transparent)
              110px,
            transparent 180px 300px
          ),
          repeating-linear-gradient(
            to right,
            transparent 0 30px,
            color-mix(in oklab, var(--color-graph-package) 22%, transparent)
              90px,
            transparent 150px 240px
          );
        transform: rotate(-28deg) scale(1.9);
        filter: blur(26px);
        animation: beams-tight-drift 21s linear infinite;
      }

      @keyframes beams-tight-drift {
        from {
          background-position:
            0 0,
            0 0;
        }
        to {
          background-position:
            600px 0,
            -480px 0;
        }
      }

      [data-backdrop="beams-single"] .plane {
        background-image: repeating-linear-gradient(
          to right,
          transparent 0 120px,
          color-mix(in oklab, var(--color-graph-repository) 30%, transparent)
            520px,
          transparent 920px 1040px
        );
        transform: rotate(-10deg) scale(1.6);
        filter: blur(46px);
        animation: beams-single-drift 38s linear infinite;
      }

      @keyframes beams-single-drift {
        from {
          background-position: 0 0;
        }
        to {
          background-position: 1040px 0;
        }
      }

      /* D4 splits the work: the drift lives on `.plane` and the swell on
         `.plane-b`, because one element cannot animate `background-position`
         and `opacity` on two different cadences. */
      [data-backdrop="beams-breathe"] .plane {
        background-image:
          repeating-linear-gradient(
            to right,
            transparent 0 70px,
            color-mix(in oklab, var(--color-graph-repository) 26%, transparent)
              190px,
            transparent 320px 450px
          ),
          repeating-linear-gradient(
            to right,
            transparent 0 90px,
            color-mix(in oklab, var(--color-graph-exact) 20%, transparent) 240px,
            transparent 400px 580px
          );
        transform: rotate(-16deg) scale(1.6);
        filter: blur(28px);
        animation: beams-breathe-drift 26s linear infinite;
      }

      @keyframes beams-breathe-drift {
        from {
          background-position:
            0 0,
            0 0;
        }
        to {
          background-position:
            450px 0,
            -580px 0;
        }
      }

      [data-backdrop="beams-breathe"] .plane-b {
        inset: 0;
        background: radial-gradient(
          ellipse 46% 60% at 72% 78%,
          color-mix(in oklab, var(--color-graph-exact) 12%, transparent),
          transparent 70%
        );
        animation: breathe 13s ease-in-out infinite alternate;
      }

      @keyframes breathe {
        from {
          opacity: 0.3;
        }
        to {
          opacity: 1;
        }
      }

      /* ===================================================================
         E - grid with a sheen
         ===================================================================

         The grid never moves; the highlight is the plane's own `::after`, so
         the grid's mask clips it and the sweep cannot light the band's edges.
         It ping-pongs with `alternate` rather than looping, so there is no
         restart to hide. */
      [data-backdrop^="sheen"] .plane,
      [data-backdrop^="hybrid"] .plane {
        inset: 0;
      }

      [data-backdrop^="sheen"] .plane,
      [data-backdrop="hybrid-lit-field"] .plane,
      [data-backdrop="hybrid-lit-grid"] .plane {
        -webkit-mask-image: radial-gradient(
          ellipse 76% 66% at 50% 50%,
          #000 0%,
          transparent 80%
        );
        mask-image: radial-gradient(
          ellipse 76% 66% at 50% 50%,
          #000 0%,
          transparent 80%
        );
      }

      [data-backdrop="sheen-base"] .plane {
        background-image:
          repeating-linear-gradient(
            to right,
            var(--color-rule-strong) 0 1px,
            transparent 1px 72px
          ),
          repeating-linear-gradient(
            to bottom,
            var(--color-rule-strong) 0 1px,
            transparent 1px 72px
          );
      }

      [data-backdrop="sheen-fine"] .plane {
        background-image:
          repeating-linear-gradient(
            to right,
            color-mix(in oklab, var(--color-rule-strong) 72%, transparent) 0 1px,
            transparent 1px 40px
          ),
          repeating-linear-gradient(
            to bottom,
            color-mix(in oklab, var(--color-rule-strong) 72%, transparent) 0 1px,
            transparent 1px 40px
          );
      }

      [data-backdrop="sheen-coarse"] .plane {
        background-image:
          repeating-linear-gradient(
            to right,
            var(--color-rule-strong) 0 1px,
            transparent 1px 128px
          ),
          repeating-linear-gradient(
            to bottom,
            var(--color-rule-strong) 0 1px,
            transparent 1px 128px
          );
      }

      /* E4 draws the crossings as well as the lines. The dot has to sit at the
         centre of its own tile, with the tile shifted back half a step, so that
         it lands on an intersection whole: a gradient centred on the tile's
         corner paints one quadrant of the circle and its neighbours do not
         supply the other three, which is a quarter of the intended mark and
         easy to mistake for nothing being drawn at all. */
      [data-backdrop="sheen-nodes"] .plane {
        background-image:
          radial-gradient(
            circle at 44px 44px,
            color-mix(in oklab, var(--color-graph-cross) 60%, transparent) 2.5px,
            transparent 3.2px
          ),
          repeating-linear-gradient(
            to right,
            color-mix(in oklab, var(--color-rule-strong) 80%, transparent) 0 1px,
            transparent 1px 88px
          ),
          repeating-linear-gradient(
            to bottom,
            color-mix(in oklab, var(--color-rule-strong) 80%, transparent) 0 1px,
            transparent 1px 88px
          );
        background-size:
          88px 88px,
          auto,
          auto;
        background-position:
          -44px -44px,
          0 0,
          0 0;
      }

      [data-backdrop="sheen-base"] .plane::after,
      [data-backdrop="sheen-fine"] .plane::after,
      [data-backdrop="sheen-coarse"] .plane::after,
      [data-backdrop="sheen-nodes"] .plane::after,
      [data-backdrop="hybrid-lit-field"] .plane::after {
        position: absolute;
        content: "";
        inset: -50% -100%;
      }

      [data-backdrop="sheen-base"] .plane::after {
        background: linear-gradient(
          100deg,
          transparent 42%,
          color-mix(in oklab, var(--color-gray-100) 7%, transparent) 50%,
          transparent 58%
        );
        animation: sheen-cross 15s ease-in-out infinite alternate;
      }

      [data-backdrop="sheen-fine"] .plane::after {
        background: linear-gradient(
          100deg,
          transparent 45%,
          color-mix(in oklab, var(--color-gray-100) 9%, transparent) 50%,
          transparent 55%
        );
        animation: sheen-cross 9s ease-in-out infinite alternate;
      }

      [data-backdrop="sheen-coarse"] .plane::after {
        background: linear-gradient(
          100deg,
          transparent 38%,
          color-mix(in oklab, var(--color-graph-repository) 16%, transparent) 50%,
          transparent 62%
        );
        animation: sheen-cross 19s ease-in-out infinite alternate;
      }

      @keyframes sheen-cross {
        from {
          translate: -34% 0;
        }
        to {
          translate: 34% 0;
        }
      }

      [data-backdrop="sheen-nodes"] .plane::after {
        background: linear-gradient(
          to bottom,
          transparent 36%,
          color-mix(in oklab, var(--color-gray-100) 8%, transparent) 50%,
          transparent 64%
        );
        animation: sheen-fall 13s ease-in-out infinite alternate;
      }

      @keyframes sheen-fall {
        from {
          translate: 0 -26%;
        }
        to {
          translate: 0 26%;
        }
      }

      /* ===================================================================
         D x E - both
         =================================================================== */

      [data-backdrop^="hybrid"] .plane {
        background-image:
          repeating-linear-gradient(
            to right,
            var(--color-rule-strong) 0 1px,
            transparent 1px 96px
          ),
          repeating-linear-gradient(
            to bottom,
            var(--color-rule-strong) 0 1px,
            transparent 1px 96px
          );
      }

      /* H1 keeps the beams under the grid, so the lines stay neutral. */
      [data-backdrop="hybrid-lit-field"] .plane-b {
        z-index: -3;
      }

      /* H2 puts them over it: the grid is what changes colour. */
      [data-backdrop="hybrid-lit-grid"] .plane-b {
        z-index: -2;
      }

      [data-backdrop^="hybrid"] .plane-b {
        background-image:
          repeating-linear-gradient(
            to right,
            transparent 0 80px,
            color-mix(in oklab, var(--color-graph-repository) 24%, transparent)
              240px,
            transparent 400px 560px
          ),
          repeating-linear-gradient(
            to right,
            transparent 0 120px,
            color-mix(in oklab, var(--color-graph-package) 16%, transparent)
              300px,
            transparent 470px 700px
          );
        transform: rotate(-13deg) scale(1.6);
        filter: blur(30px);
        animation: hybrid-drift 32s linear infinite;
      }

      @keyframes hybrid-drift {
        from {
          background-position:
            0 0,
            0 0;
        }
        to {
          background-position:
            560px 0,
            -700px 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .plane,
        .plane-b,
        .plane::after {
          animation: none;
        }
      }
    </style>
  </body>
</html>
